    "./schemas/kiln.schema.json": ["kiln.yaml", "*/kiln.yaml"],
    "./schemas/kiln-lock.schema.json": ["kiln.lock.yaml", "*/kiln.lock.yaml"],
    "./schemas/migration.schema.json": "extensions/*/migrations/*.yaml",

# Keep every source file LF in the working tree so the bundled catalog,
# extension goldens, and `tool/check_*.dart` byte comparisons do not drift
# between Windows, macOS, and Linux contributors.
* text=auto eol=lf

# Windows launchers must keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.tgz binary
*.gz binary
*.zip binary
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary

# Generated files still count as text; this only stops diff churn in reviews.
packages/kiln_cli/lib/src/bundles/*.dart linguist-generated=true
extensions/*/test/goldens/rendered.json linguist-generated=true

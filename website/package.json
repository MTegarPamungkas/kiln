{
  "name": "kiln-docs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Documentation website for the Kiln Flutter framework.",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && vite build",
    "preview": "vite preview",
    "build:pages": "npm run content && vite build --base=/ && node scripts/copy-404.mjs",
    "deploy": "npm run build:pages && node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "dompurify": "^3.4.17",
    "fuse.js": "^7.5.0",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.71.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.7",
    "yaml": "^2.9.1"
  }
}

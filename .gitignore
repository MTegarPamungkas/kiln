# Dart and Flutter
.dart_tool/
.packages
.pub-cache/
.pub/
build/
coverage/
*.lock.tmp
.flutter-plugins
.flutter-plugins-dependencies

# Generated bundles and goldens are committed; transient outputs are not.
*.iml
.idea/
.vscode/*.log

# The compiled CLI is a build artifact: rebuild it with bin/rebuild.cmd and
# attach it to a release instead of committing ~12 MB per rebuild.
/bin/kiln.exe

# Local verification logs
/*.log

# Local Kiln state
.kiln/backups/
.kiln/journal/
.kiln/logs/

# Local environment files
env/*.json
!env/*.example.json

# Local end-to-end proof output
/e2e_app/
/e2e_appwrite/
/e2e_auth/
/e2e_bloc/
/e2e_firebase/
/e2e_l10n/
/e2e_riverpod/
